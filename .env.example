# WordPress origin that serves the REST API (the existing site).
WP_URL=https://timetv.news

# Public site origin for canonicals, sitemaps and OG tags.
# In production this becomes https://timetv.news once DNS cuts over.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the publish webhook that triggers on-demand revalidation.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=
